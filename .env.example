# Copy to .env and adjust. Real environment variables take precedence over this file.

# development (default) or production. Production refuses the simulated device
# and logs at INFO instead of DEBUG.
ENVIRONMENT=development

# Where the measurements come from: "serial" (the ESP32 board) or "simulated"
# (synthetic data, no hardware needed).
WIFIMON_DEVICE=serial

# Serial port of the board. Leave empty to auto-detect an Espressif board (USB vendor 0x303a).
WIFIMON_SERIAL_PORT=

# Dashboard address. Keep 127.0.0.1 unless you need access from another machine:
# the dashboard has no login and accepts Wi-Fi passwords.
WIFIMON_HTTP_HOST=127.0.0.1
WIFIMON_HTTP_PORT=8765

# SQLite database with all sessions and samples.
WIFIMON_DB=data/wifimon.db

# Default network for connection mode. The dashboard can override these per session.
# The password is only sent to the board; it is never stored in the database.
WIFI_SSID=
WIFI_PASSWORD=

# Host to ping in connection mode. Empty means the network's default gateway.
WIFIMON_PING_TARGET=

# -- Fleet server (fleet/) --------------------------------------------------------
# Unset values fall back to development defaults; production refuses insecure ones.

# PostgreSQL + TimescaleDB. Default: the `db` service from docker-compose.yml.
DATABASE_URL=postgresql+psycopg://fleet:fleet-dev@127.0.0.1:5433/fleet

# Random string (at least 32 characters) used to hash unit keys. Required in production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLEET_SECRET_KEY=

# Admin password hash from `fleet hash-password`. Empty in development means the password is "admin".
FLEET_ADMIN_PASSWORD_HASH=

# Address units and browsers use to reach the server. Must be https:// in production.
FLEET_PUBLIC_URL=http://localhost:8800

# Admin login lifetime and how long a silent unit counts as online.
FLEET_SESSION_HOURS=12
FLEET_OFFLINE_AFTER_S=600

# Default measurement settings sent to units in the handshake (per-unit overrides are possible).
FLEET_SAMPLE_INTERVAL_S=5
FLEET_BATCH_INTERVAL_S=60
FLEET_SCAN_INTERVAL_S=600
FLEET_SERVER_PING_INTERVAL_S=30

# Remote updates: the server offers this agent file to units running a different version.
# Default: unit/app.py in the source tree (/app/unit/app.py in the Docker image).
FLEET_AGENT_UPDATES=true
FLEET_AGENT_PATH=

# Reverse proxies (IPs or networks, comma-separated) allowed to set X-Forwarded-For and
# X-Forwarded-Proto. Empty: forwarded headers are ignored. Behind Caddy on the same host: 127.0.0.1
FLEET_TRUSTED_PROXIES=

# Time zone for daily candles on the dashboard.
FLEET_TIMEZONE=Europe/Tallinn

# Browser provisioning (#4). Address units use (plain HTTP with signed requests); empty means
# FLEET_PUBLIC_URL with http://. Firmware directory for `fleet fetch-firmware` (default ./firmware).
FLEET_UNIT_URL=
FLEET_FIRMWARE_DIR=
